#!/bin/bash

mkdir -p ~/.vim/backup

mkdir -p ~/.config/zsh/functions
[ type rustup > /dev/null 2>&1 ] && rustup completions zsh cargo > ~/.config/zsh/functions/_cargo || true
[ type swift > /dev/null 2>&1 ] && wift package completion-tool generate-zsh-script > ~/.config/zsh/functions/_swift || true
