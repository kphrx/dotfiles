# zmodload zsh/zprof && zprof

function load_with_compile {
  local filename="$1"
  echo "Load: $filename"
  ensure_zcompiled "$filename"
  builtin source "$filename"
  echo "Loaded: $filename"
}

function ensure_zcompiled {
  local filename="$1"
  local compiled="$1.zwc"
  if [[ ! -r "$compiled" || "$filename" -nt "$compiled" ]]; then
    echo "Compiling $filename"
    zcompile "$filename"
  fi
}

function zcompile_files {
    if [ -f ~/.zshenv ]; then
        ensure_zcompiled ~/.zshenv
    fi
    if [ -f "${ZDOTDIR}/.zprofile" ]; then
        ensure_zcompiled "${ZDOTDIR}/.zprofile"
    fi
    if [ -f "${ZDOTDIR}/.zshrc" ]; then
        ensure_zcompiled "${ZDOTDIR}/.zshrc"
    fi
    if [ -f "${ZDOTDIR}/.zlogin" ]; then
        ensure_zcompiled "${ZDOTDIR}/.zlogin"
    fi
    if [ -f "${ZDOTDIR}/.zlogout" ]; then
        ensure_zcompiled "${ZDOTDIR}/.zlogout"
    fi
}

zcompile_files

# Prompt theme
ZSH_THEME="powerline"

# Core settings
for config in $ZDOTDIR/conf.d/*.zsh; do
  load_with_compile "$config"
done
unset config

